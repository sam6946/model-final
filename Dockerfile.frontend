# ---------------------------------------------------------------------------
# KEMTA — image frontend (build Vite puis service Nginx)
#
# Nginx sert l'application React compilée, met en cache les assets versionnés et
# relaie /api et /media vers le conteneur backend : le navigateur ne connaît
# jamais l'adresse interne des services.
# ---------------------------------------------------------------------------
FROM node:22-alpine AS builder

WORKDIR /app
ENV CI=true

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./
# Vite est un outil de build : aucune variable secrète n'entre ici, seulement
# des valeurs publiques injectées à la compilation.
ARG VITE_PUBLIC_SITE_URL=https://kemta.cm
ENV VITE_PUBLIC_SITE_URL=$VITE_PUBLIC_SITE_URL
RUN npm run build


FROM nginx:1.27-alpine AS runtime

RUN rm /etc/nginx/conf.d/default.conf
COPY docker/nginx.conf /etc/nginx/conf.d/kemta.conf
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -qO- http://127.0.0.1/healthz >/dev/null || exit 1

CMD ["nginx", "-g", "daemon off;"]
