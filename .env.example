# ---------------------------------------------------------------------------
# KEMTA — modèle de configuration
#
#   cp .env.example .env    puis renseigner les valeurs réelles.
#
# RÈGLES
#   · .env n'est JAMAIS versionné (voir .gitignore) et ne doit jamais être
#     exposé au frontend : aucune clé SMS, paiement, JWT ou base ne transite
#     par le navigateur.
#   · En développement, seules les variables marquées [dev] sont utiles : sans
#     .env, `config.settings.dev` démarre en SQLite avec l'OTP affiché.
#   · En production (config.settings.prod), SECRET_KEY et REDIS_URL sont
#     obligatoires : le démarrage échoue volontairement s'ils manquent.
# ---------------------------------------------------------------------------

# --- Socle Django -----------------------------------------------------------
# Générer : python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
# DEBUG=1 uniquement en local. Jamais en production.
DEBUG=0
# Hôtes autorisés (séparés par des virgules).
ALLOWED_HOSTS=kemta.cm,www.kemta.cm,api.kemta.cm
# Origines de confiance pour le CSRF et le CORS (frontend public).
CSRF_TRUSTED_ORIGINS=https://kemta.cm,https://www.kemta.cm
CORS_ALLOWED_ORIGINS=https://kemta.cm,https://www.kemta.cm
# URL publique du site, utilisée pour les liens absolus (partage, e-mails).
PUBLIC_SITE_URL=https://kemta.cm
# En-tête de proxy de l'hébergeur (TLS terminé en amont).
SECURE_SSL_REDIRECT=1
SECURE_HSTS_SECONDS=15552000

# --- Base de données --------------------------------------------------------
# Soit DATABASE_URL, soit les variables POSTGRES_*. En développement, laisser
# vide : KEMTA bascule automatiquement sur SQLite.
DATABASE_URL=postgresql://kemta:motdepasse@db:5432/kemta
POSTGRES_DB=kemta
POSTGRES_USER=kemta
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432
DB_CONN_MAX_AGE=60

# --- Redis / Celery ---------------------------------------------------------
# Obligatoire en production : cache, compteurs de débit, tickets OTP, queues.
# En développement, laisser vide : repli mémoire et Celery synchrone.
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_TASK_ALWAYS_EAGER=0
CELERY_CONCURRENCY=2
CELERY_WORKERS=1

# --- Authentification -------------------------------------------------------
# Durée des jetons d'accès et de rafraîchissement.
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14
# Code à usage unique par SMS.
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=45
OTP_MAX_REQUESTS_PER_WINDOW=5
OTP_WINDOW_SECONDS=3600
# [dev] Affiche le code OTP dans la réponse et les journaux (jamais en prod).
OTP_DEV_ECHO=1

# --- SMS (OTP, alertes marchés) --------------------------------------------
# console = journalisation ; sinon fournisseur branché via l'abstraction
# KEMTA (SMSProvider) : nexah, orange, twilio…
SMS_PROVIDER=console
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=KEMTA
SMS_BASE_URL=
SMS_TIMEOUT_SECONDS=15

# --- Paiements (Mobile Money, carte) ---------------------------------------
# manual = encaissement constaté par l'équipe KEMTA (repli sûr) ; mtm_momo /
# orange_money / card utilisent PaymentProvider avec idempotence côté API.
PAYMENT_PROVIDER=manual
PAYMENT_API_KEY=
PAYMENT_API_SECRET=
PAYMENT_BASE_URL=
PAYMENT_TIMEOUT_SECONDS=20
# Secret partagé pour vérifier la signature HMAC-SHA256 des webhooks.
PAYMENT_WEBHOOK_SECRET=
PAYMENT_CURRENCY=XAF
PAYMENT_MIN_AMOUNT_XAF=1000

# --- Stockage objet (photos de chantier, pièces) ---------------------------
# Vide = stockage local (développement). En production : S3, Cloudflare R2 ou
# MinIO. Le frontend reçoit des URL signées, jamais les clés.
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=eu-west-3
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_PUBLIC_BASE_URL=
OBJECT_STORAGE_PRESIGN_TTL=900

# --- Médias -----------------------------------------------------------------
MAX_UPLOAD_BYTES=15728640
IMAGE_MAX_DIMENSION=2000

# --- E-mails ----------------------------------------------------------------
DEFAULT_FROM_EMAIL=KEMTA <notifications@kemta.cm>
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
WHATSAPP_ENABLED=0

# --- Identité KEMTA ---------------------------------------------------------
KEMTA_BRAND_NAME=KEMTA SUIVI
KEMTA_SUPPORT_PHONE=+237600000000
KEMTA_SUPPORT_EMAIL=contact@kemta.cm
KEMTA_REFERENCE_PREFIX=KEMTA
DEFAULT_COUNTRY_CODE=CM

# --- Observations -----------------------------------------------------------
LOG_JSON=1
LOG_LEVEL=INFO

# --- Développement local ----------------------------------------------------
# Frontend Vite : port du serveur de développement et cible du proxy /api.
VITE_API_TARGET=http://127.0.0.1:8000
VITE_PUBLIC_SITE_URL=http://localhost:5173

# --- Docker Compose ---------------------------------------------------------
KEMTA_TAG=latest
FRONTEND_PORT=8080
BACKEND_PORT=8000
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60
DB_MEMORY_LIMIT=1g
REDIS_MEMORY_LIMIT=512m
BACKEND_MEMORY_LIMIT=1g
WORKER_MEMORY_LIMIT=768m
FRONTEND_MEMORY_LIMIT=256m
BACKUP_RETENTION_DAYS=14
